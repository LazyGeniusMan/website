---
import * as Card from "$lib/components/ui/card/index.js";
import Icon from "./Icon.svelte";
import MapPin from "@lucide/svelte/icons/map-pin";
---

<Card.Root class="rounded-none" data-motion>
  <Card.Content>
    <figure class="m-0">
      <svg
        viewBox="0 0 800 340"
        role="img"
        aria-label="Flat illustration of workplaces in Bandung"
        class="aspect-[21/9] w-full"
        preserveAspectRatio="xMidYMid slice"
      >
        <rect width="800" height="340" fill="var(--color-card)"></rect>
        <circle cx="620" cy="90" r="44" fill="var(--color-primary)"></circle>
        <rect x="0" y="240" width="800" height="100" fill="var(--color-foreground)"></rect>
        <g fill="var(--color-muted-foreground)">
          <rect x="40" y="180" width="70" height="100"></rect>
          <rect x="130" y="150" width="56" height="130"></rect>
          <rect x="205" y="200" width="84" height="80"></rect>
          <rect x="310" y="160" width="60" height="120"></rect>
          <rect x="390" y="190" width="76" height="90"></rect>
          <rect x="486" y="140" width="58" height="140"></rect>
          <rect x="564" y="195" width="80" height="85"></rect>
          <rect x="664" y="170" width="56" height="110"></rect>
          <rect x="736" y="205" width="48" height="75"></rect>
        </g>
        <g fill="var(--color-card)">
          <rect x="52" y="196" width="8" height="8"></rect>
          <rect x="142" y="166" width="8" height="8"></rect>
          <rect x="322" y="176" width="8" height="8"></rect>
          <rect x="498" y="156" width="8" height="8"></rect>
          <rect x="676" y="186" width="8" height="8"></rect>
        </g>
        <line
          x1="0"
          y1="282"
          x2="800"
          y2="282"
          stroke="var(--color-card)"
          stroke-opacity="0.4"
          stroke-width="2"
        ></line>
      </svg>
    </figure>
  </Card.Content>
  <Card.Footer>
    <p class="credit-line m-0">
      <span class="inline-flex items-center gap-1">
        <Icon of={MapPin} data-icon="inline-end" aria-hidden="true" />Bandung, Indonesia. Flat illustration, no photograph.
      </span>
    </p>
  </Card.Footer>
</Card.Root>
