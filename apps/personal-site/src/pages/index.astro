---
import Layout from "../layouts/Layout.astro";
import { publishedPosts, publishedProjects } from "../lib/collections";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import {
  abs,
  breadcrumbNode,
  collectionPageNode,
  personRefNode,
  resolveSiteUrl,
  toGraph,
  websiteNode,
} from "../lib/jsonld";
import Section from "../components/Section.astro";
import * as Card from "$lib/components/ui/card/index.js";
import { Button } from "$lib/components/ui/button/index.js";
import Icon from "../components/Icon.svelte";
import ArrowRight from "@lucide/svelte/icons/arrow-right";
import ArrowUpRight from "@lucide/svelte/icons/arrow-up-right";

const skillsAll = await getCollection("skills");
const orgsAll = await getCollection("organizations");
const expAll = await getCollection("experience");
const eduAll = await getCollection("education");
const credsAll = await getCollection("credentials");
const projects = await publishedProjects();
const posts = await publishedPosts();
const persons = await getCollection("person");
const person = persons.find((p) => p.id === "andriyansyah") ?? persons[0];

const items = [
  {
    href: "/about",
    label: "Profile",
    count: persons.length,
    unit: "person",
    detail: `${person?.data.name ?? "Andriyansyah Nurrachman"}, ${person?.data.jobTitle ?? "Business Process and Enterprise System Specialist"} in Bandung.`,
  },
  {
    href: "/skills",
    label: "Skills",
    count: skillsAll.length,
    unit: "topics",
    detail: "Process, systems, and data topics used across roles and projects.",
  },
  {
    href: "/experience",
    label: "Work Experience",
    count: expAll.length,
    unit: "roles",
    detail: "Business process modelling, ERP, and automation across freelance, startups, and campus.",
  },
  {
    href: "/organizations",
    label: "Organizations",
    count: orgsAll.length,
    unit: "orgs",
    detail: "Employers, clients, and campuses behind the roles.",
  },
  {
    href: "/education",
    label: "Education",
    count: eduAll.length,
    unit: "degree",
    detail: "Informatics degree entry with coursework and dates.",
  },
  {
    href: "/certifications",
    label: "Certifications",
    count: credsAll.length,
    unit: "credentials",
    detail: "English proficiency and process credentials with verification.",
  },
  {
    href: "/projects",
    label: "Projects",
    count: projects.length,
    unit: "cases",
    detail: "Process model first, system second. Selected delivery cases.",
  },
  {
    href: "/blog",
    label: "Blog",
    count: posts.length,
    unit: "notes",
    detail: "Notes on process, accounting systems, and automation from real work.",
  },
];

const recordItems = items.filter((d) => d.href !== "/about");

const siteUrl = resolveSiteUrl(Astro.site);
const graphNodes = toGraph([
  collectionPageNode({
    path: "/",
    siteUrl,
    name: "Andriyansyah Nurrachman",
    description:
      "Andriyansyah Nurrachman is a Business Process and Enterprise System Specialist in Bandung. Browse skills, experience, organizations, education, certifications, projects, and blog notes.",
    items: items.map((d) => ({ name: d.label, url: abs(d.href) })),
  }),
  websiteNode(),
  personRefNode(siteUrl),
  breadcrumbNode("/", [{ name: "Home", item: "/" }]),
]);
---

<Layout
  title="Andriyansyah Nurrachman"
  description="Andriyansyah Nurrachman is a Business Process and Enterprise System Specialist in Bandung. Browse skills, experience, organizations, education, certifications, projects, and blog notes."
  graphNodes={graphNodes}
>
  <Section variant="sheet" labelledby="home-heading">
    <h1 id="home-heading" class="display w-full min-w-0 max-w-full break-words text-[clamp(2.75rem,10vw,9rem)]" style="letter-spacing:-0.055em;overflow-wrap:break-word">
      <span data-mask class="block"><span class="block">Andriyansyah</span></span>
      <span data-mask class="block"><span class="block">Nurrachman</span></span>
    </h1>
    <div class="mt-10 grid min-w-0 gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
      <div class="min-w-0">
        <p class="max-w-[34ch] text-lg leading-relaxed text-foreground">
          Business Process and Enterprise System Specialist in Bandung, streamlining business processes and enterprise systems.
        </p>
        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="/about" class="h-auto max-w-full min-h-11 rounded-none px-6 py-3 text-lg whitespace-normal">
            View profile
            <Icon of={ArrowRight} data-icon="inline-end" aria-hidden="true" />
          </Button>
          <a class="inline-flex min-h-11 items-center gap-2 text-lg text-foreground underline underline-offset-4 hover:text-primary" href="/contact">
            Contact me
            <Icon of={ArrowUpRight} data-icon="inline-end" aria-hidden="true" />
          </a>
        </p>
      </div>
    </div>

    <h2 id="index-heading" class="mt-16 text-2xl font-medium md:mt-24 md:text-3xl">Index</h2>
    <p class="mt-3 max-w-[60ch] text-lg text-foreground">
      All information related to Andriyansyah Nurrachman
    </p>
    <ul class="mt-8 grid min-w-0 grid-cols-1 gap-6 pb-4 sm:grid-cols-2 lg:grid-cols-3">
      {recordItems.map((d) => (
        <li class="min-w-0">
          <Card.Root class="h-full rounded-none">
            <Card.Header class="rounded-none">
              <Card.Title>
                <h3 class="text-2xl font-medium">
                  <a class="text-foreground underline-offset-4 hover:text-primary hover:underline" href={d.href}>
                    {d.label}
                  </a>
                </h3>
              </Card.Title>
            </Card.Header>
            <Card.Content class="rounded-none">
              <p class="display m-0 text-2xl tabular-nums md:text-3xl">{`${d.count} ${d.unit}`}</p>
              <p class="mt-2 max-w-[60ch] text-lg leading-relaxed text-foreground">{d.detail}</p>
            </Card.Content>
            <Card.Footer class="rounded-none">
              <a class="inline-flex min-h-11 items-center gap-2 text-lg text-foreground underline-offset-4 hover:text-primary hover:underline" href={d.href} aria-label={`Open ${d.label}`}>
                Open
                <Icon of={ArrowUpRight} data-icon="inline-end" aria-hidden="true" />
              </a>
            </Card.Footer>
          </Card.Root>
        </li>
      ))}
    </ul>
  </Section>
</Layout>
