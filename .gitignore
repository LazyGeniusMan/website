# generated artifacts (built, never committed)
apps/personal-site/public/cv.pdf

# binary asset policy (foundation decision: untracked fetch-only, no exceptions).
# RAW originals are NEVER committed; only the manifest + placeholder are tracked.
# CI `git ls-files` binary gate fails on ANY tracked binary (no manifest-covered
# allowlist). scripts/fetch-assets.mjs (rclone, manifest-as-truth) restores bytes
# at dev/build time. Consistent with .github/workflows/personal-site.yml audit.
apps/personal-site/src/assets/*
!apps/personal-site/src/assets/.assets-manifest.json
!apps/personal-site/src/assets/.gitkeep
assets/*
!assets/credits.json
!assets/.assets-manifest.json
!assets/.gitkeep
