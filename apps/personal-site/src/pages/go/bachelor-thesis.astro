---
import GoRedirect from "../../components/GoRedirect.astro";

const target = "https://github.com/LazyGeniusMan/thesis";
const label = "the bachelor thesis repository";
const blurb = "Redirecting to the bachelor thesis repository.";
---

<GoRedirect target={target} label={label} blurb={blurb}>
  <script is:inline>
    window.location.replace("https://github.com/LazyGeniusMan/thesis");
  </script>
</GoRedirect>
