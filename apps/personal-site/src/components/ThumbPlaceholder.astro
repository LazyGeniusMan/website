---
import * as Avatar from "$lib/components/ui/avatar/index.js";
import { cn } from "$lib/utils.js";
import { monogramOf } from "../lib/monogram";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const { initials, bg, fg } = monogramOf(name);
---

<!-- ~keep: ThumbPlaceholder renders shadcn Avatar.Root with a static
  avatar-fallback span (same data-slot hook + monogramOf initials/bg-fg the
  shadcn Fallback emits). A Svelte Avatar.Fallback nested from .astro renders
  as a separate Svelte root, so bits-ui Root context never reaches it and SSR
  prerender throws `Context Avatar.Root not found`. Static span is SSR-safe.
  No Avatar.Image (display:none without JS). Astro SSR static, zero JS by design.
-->
<Avatar.Root
  class={cn(
    "flex size-16 shrink-0 items-center justify-center rounded-none after:rounded-none select-none",
    className,
  )}
  style={`background-color: ${bg}; color: ${fg};`}
  role="img"
  aria-label={`${name} monogram`}
>
  <span data-slot="avatar-fallback" aria-hidden="true" class="text-lg font-bold">{initials}</span>
</Avatar.Root>
